#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# CUSTOM APPLY
#=================================================

# difficulty is stored in settings only; re-render anubis.env + fragments so
# the running config picks it up. Core restarts the panel's services after.
ynh_app_config_apply() {
	_ynh_app_config_apply
	ANUBIS_APP="$app" "$APPLY_BIN" render || ynh_die "Failed to re-apply anubis configuration"
}

#=================================================
# RUN CONFIG PANEL ACTION
#=================================================
ynh_app_config_run $1
