#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# CUSTOM APPLY
#=================================================

# difficulty is settings-only: re-render anubis.env + fragments (core restarts the services afterwards).
ynh_app_config_apply() {
	_ynh_app_config_apply
	ANUBIS_APP="$app" "$APPLY_BIN" render || ynh_die "Failed to re-apply anubis configuration"
}

#=================================================
# RUN CONFIG PANEL ACTION
#=================================================
ynh_app_config_run $1
