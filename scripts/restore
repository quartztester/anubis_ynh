#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

# Keep this path for calling _common.sh inside the execution's context of backup and restore scripts
source ../settings/scripts/_common.sh
source /usr/share/yunohost/helpers

#=================================================
# RESTORE THE APP MAIN DIR
#=================================================
ynh_script_progression "Restoring the app main directory..."

ynh_restore "$install_dir"
chown -R root:root "$install_dir"
chmod 0755 "$install_dir/bin/anubis"

#=================================================
# RESTORE SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Restoring system configurations..."

ynh_restore "/etc/nginx/conf.d/$domain.d/$app.conf"
ynh_restore "/etc/systemd/system/$app.service"
ynh_restore "/etc/systemd/system/$app-webui.service"
systemctl enable "$app.service" --quiet
systemctl enable "$app-webui.service" --quiet

ynh_restore "$APPLY_BIN"
chmod 0755 "$APPLY_BIN"
ynh_restore "$SUDOERS_FILE"
chmod 0440 "$SUDOERS_FILE"

yunohost service add "$app" --description="Anubis bot shield (auth_request)" --log="/var/log/syslog"
yunohost service add "$app-webui" --description="Anubis domain-protection GUI" --log="/var/log/syslog"

# Per-domain protection fragments depend on the current domain list; rather
# than replaying each archived fragment, regenerate them all from the
# restored app settings (protected_domains came back with the archive).
ynh_print_info "Per-domain fragments are regenerated from restored settings..."

#=================================================
# RE-APPLY FROM SETTINGS
#=================================================
ynh_script_progression "Re-applying nginx fragments from restored settings..."

run_apply render

ynh_systemctl --service="$app" --action="start"
ynh_systemctl --service="$app-webui" --action="start"

systemctl reload nginx

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Restore of $app completed"
