[Unit]
Description=Anubis domain-protection admin GUI (__APP__)
After=network.target

[Service]
Type=simple
User=__APP__
Group=__APP__
WorkingDirectory=__INSTALL_DIR__/webui
Environment=ANUBIS_APP=__APP__
Environment=ANUBIS_PORT=__PORT__
Environment=ANUBIS_WEBUI_PORT=__PORT_WEBUI__
ExecStart=/usr/bin/waitress-serve --listen=127.0.0.1:__PORT_WEBUI__ --call anubis_webui:create_app
Restart=always
RestartSec=10s

# Sandboxing: this service sudo-calls its root helper (anubis-ynh-apply),
# which writes /etc/nginx/conf.d fragments and app settings.yml, so no
# ProtectSystem/ReadOnlyPaths; any seccomp-backed option implicitly raises
# NoNewPrivileges here (breaks sudo), so the four options below avoid both.
 PrivateTmp=yes
 DevicePolicy=closed
 ProtectProc=invisible
 ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
