# Anubis __APP__ admin GUI
[Unit]
Description=Anubis domain-protection admin GUI (__APP__)
After=network.target

[Service]
Type=simple
User=__APP__
Group=__APP__
WorkingDirectory=__INSTALL_DIR__/webui
Environment=ANUBIS_APP=__APP__
Environment=ANUBIS_PORT=__PORT__
Environment=ANUBIS_WEBUI_PORT=__PORT_WEBUI__
ExecStart=/usr/bin/waitress-serve --listen=127.0.0.1:__PORT_WEBUI__ --call anubis_webui:create_app
Restart=always
RestartSec=10s

# Sandboxing. IMPORTANT - this service sudo-calls its root helper
# (/usr/local/bin/anubis-ynh-apply); keep these constraints in sync with
# that requirement:
#  * NoNoNewPrivileges + no seccomp-based options. On this systemd, any
#    seccomp-backed sandbox option (SystemCallFilter, ProtectKernelTunables,
#    LockPersonality, PrivateDevices, CapabilityBoundingSet ...) implicitly
#    raises NoNewPrivileges, which breaks sudo - verified empirically.
#  * No ProtectSystem/ReadOnlyPaths: the helper writes
#    /etc/nginx/conf.d fragments and /etc/yunohost/apps/<app>/settings.yml.
# The four mount/namespace options below imply neither and are safe:
 PrivateTmp=yes
 DevicePolicy=closed
 ProtectProc=invisible
 ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
